{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "pca-aisyiyah-sugio",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "pca-aisyiyah-sugio"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "pca-aisyiyah-sugio"
    }
  ],

  "images": {
    "binding": "IMAGES"
  },

  "d1_databases": [
    {
      "binding": "pca_aisyiyah_sugio_db",
      "database_name": "pca-aisyiyah-sugio-db",
      "database_id": "6b26c818-4b27-4ba2-ac08-8d20ef72ec10"
    }
  ]
}